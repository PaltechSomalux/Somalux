import React, { useState, useEffect, useMemo, useRef } from 'react';
import { useLocation, useNavigate } from 'react-router-dom';
import { pastPaperData } from './PastpaperData';
import { ShareButton } from './PastpaperShare';
import { Download } from './PastpaperDownload';
import { FaHeart, FaRegHeart } from 'react-icons/fa';
import { FiSearch, FiFileText, FiFilter, FiChevronRight, FiChevronLeft, FiX, FiTrendingUp, FiDownload, FiBookmark, FiArrowLeft, FiEye } from 'react-icons/fi';
import { motion, AnimatePresence } from 'framer-motion';
import { CommentsSection } from '../../KissMe/Components/CommentsSection';
import './PaperPanel.css';

const ReactionButtons = ({ itemId, loves, onLove, isLoved }) => {
  return (
    <div className="reaction-buttons-containerpast">
      <button 
        className={`love-buttonpast ${isLoved ? 'activepast' : ''}`}
        onClick={(e) => {
          e.stopPropagation();
          onLove(itemId);
        }}
        title="Love this paper"
      >
        {isLoved ? <FaHeart color="red" /> : <FaRegHeart />}
        <span className="countpast">{loves || 0}</span>
      </button>
    </div>
  );
};

export const PaperPanel = ({ demoMode = false }) => {
  const location = useLocation();
  const navigate = useNavigate();
  const [papers, setPapers] = useState([]);
  const [displayedPapers, setDisplayedPapers] = useState([]);
  const [searchTerm, setSearchTerm] = useState('');
  const [loading, setLoading] = useState(true);
  const [visibleCount, setVisibleCount] = useState(8);
  const [selectedPaper, setSelectedPaper] = useState(null);
  const [showFilters, setShowFilters] = useState(false);
  const [activeFilter, setActiveFilter] = useState('all');
  const [sortBy, setSortBy] = useState('default');
  const [showWishlist, setShowWishlist] = useState(false);
  const [welcomeMessage, setWelcomeMessage] = useState(demoMode);
  const [universityFilter, setUniversityFilter] = useState(null);

  // Comments state for CommentsSection
  const [mediaComments, setMediaComments] = useState({});
  const [commentLikes, setCommentLikes] = useState({});
  const [currentUser] = useState('GuestUser'); // Replace with actual user logic
  const commentsRef = useRef(null);

  // Initialize state from localStorage
  const [wishlist, setWishlist] = useState(() => {
    try {
      const saved = localStorage.getItem('paperWishlist');
      return saved ? JSON.parse(saved) : [];
    } catch (error) {
      console.error('Failed to parse wishlist from localStorage', error);
      return [];
    }
  });

  const [paperLoves, setPaperLoves] = useState(() => {
    try {
      const saved = localStorage.getItem('paperLoves');
      return saved ? JSON.parse(saved) : {};
    } catch (error) {
      console.error('Failed to parse paperLoves from localStorage', error);
      return {};
    }
  });

  const [paperReactions, setPaperReactions] = useState(() => {
    try {
      const saved = localStorage.getItem('paperReactions');
      return saved ? JSON.parse(saved) : {};
    } catch (error) {
      console.error('Failed to parse paperReactions from localStorage', error);
      return [];
    }
  });

  // Ref for carousel in modal
  const carouselRef = useRef(null);

  // Handle university filter from navigation
  useEffect(() => {
    if (location.state?.universityFilter) {
      setUniversityFilter(location.state.universityFilter);
      setSearchTerm(location.state.universityFilter);
      setActiveFilter('university');
    }
  }, [location.state]);

  useEffect(() => {
    // Simulate API loading
    const timer = setTimeout(() => {
      setPapers(pastPaperData);
      setDisplayedPapers(pastPaperData.slice(0, visibleCount));
      setLoading(false);
    }, 1000);

    return () => clearTimeout(timer);
  }, [visibleCount]);

  // Persist states to localStorage
  useEffect(() => {
    localStorage.setItem('paperWishlist', JSON.stringify(wishlist));
    localStorage.setItem('paperLoves', JSON.stringify(paperLoves));
    localStorage.setItem('paperReactions', JSON.stringify(paperReactions));
    localStorage.setItem('mediaComments', JSON.stringify(mediaComments));
    localStorage.setItem('commentLikes', JSON.stringify(commentLikes));
  }, [wishlist, paperLoves, paperReactions, mediaComments, commentLikes]);

  // Comment handlers for CommentsSection
  const handleSubmitComment = async (commentData) => {
    setMediaComments((prev) => ({
      ...prev,
      [selectedPaper.id]: [...(prev[selectedPaper.id] || []), commentData],
    }));
  };

  const handleDeleteComment = async (commentId) => {
    setMediaComments((prev) => ({
      ...prev,
      [selectedPaper.id]: (prev[selectedPaper.id] || []).filter((comment) => comment.id !== commentId),
    }));
  };

  const handleLikeComment = async (commentId) => {
    setCommentLikes((prev) => {
      const isLiked = !!prev[commentId];
      return {
        ...prev,
        [commentId]: isLiked ? undefined : true,
      };
    });
  };

  const handleReplyToComment = async (commentId, replyData) => {
    setMediaComments((prev) => ({
      ...prev,
      [selectedPaper.id]: (prev[selectedPaper.id] || []).map((comment) =>
        comment.id === commentId
          ? { ...comment, replies: [...(comment.replies || []), replyData] }
          : comment
      ),
    }));
  };

  const filteredPapers = useMemo(() => {
    let result = [...papers];
     
    // Apply university filter if present
    if (activeFilter === 'university' && universityFilter) {
      result = result.filter(paper => 
        paper.university?.toLowerCase() === universityFilter.toLowerCase()
      );
    }
    
    // Apply search filter (removed rating)
    if (searchTerm && activeFilter !== 'university') {
      const term = searchTerm.toLowerCase();
      result = result.filter(paper => 
        (paper.title?.toLowerCase() || '').includes(term) ||
        (paper.course?.toLowerCase() || '').includes(term) ||
        (paper.description?.toLowerCase() || '').includes(term) ||
        (paper.university?.toLowerCase() || '').includes(term) ||
        (paper.subject?.toLowerCase() || '').includes(term) ||
        (paper.courseCode?.toLowerCase() || '').includes(term) ||
        String(paper.year || '').includes(term)
      );
    }
    
    // Apply other filters
    if (activeFilter === 'trending') {
      result = result.filter(paper => paper.trending);
    } else if (activeFilter === 'new') {
      result = result.filter(paper => paper.newUpload);
    } else if (activeFilter === 'wishlist') {
      result = result.filter(paper => wishlist.includes(paper.id));
    } else if (activeFilter === 'recent') {
      result = result.filter(paper => paper.year >= new Date().getFullYear() - 2);
    }
    
    // Apply sorting (removed rating)
    if (sortBy === 'title') {
      result.sort((a, b) => (a.title || '').localeCompare(b.title || ''));
    } else if (sortBy === 'course') {
      result.sort((a, b) => (a.course || '').localeCompare(b.course || ''));
    } else if (sortBy === 'university') {
      result.sort((a, b) => (a.university || '').localeCompare(b.university || ''));
    } else if (sortBy === 'views') {
      result.sort((a, b) => (b.views || 0) - (a.views || 0));
    } else if (sortBy === 'downloads') {
      result.sort((a, b) => (b.downloads || 0) - (a.downloads || 0));
    } else if (sortBy === 'year') {
      result.sort((a, b) => (b.year || 0) - (a.year || 0));
    }
    
    return result;
  }, [papers, searchTerm, activeFilter, sortBy, wishlist, universityFilter]);

  useEffect(() => {
    setDisplayedPapers(filteredPapers.slice(0, visibleCount));
  }, [filteredPapers, visibleCount]);

  const loadMore = () => {
    setVisibleCount(prev => prev + 4);
  };

  const viewPaperDetails = (paper) => {
    setSelectedPaper(paper);
    setWelcomeMessage(false);
  };

  const closeDetails = () => {
    setSelectedPaper(null);
  };

  const toggleFilters = () => {
    setShowFilters(!showFilters);
  };

  const handleFilterChange = (filter) => {
    setActiveFilter(filter);
    setShowFilters(false);
    setVisibleCount(8);
    setWelcomeMessage(false);
    
    // Clear university filter if changing to another filter
    if (filter !== 'university') {
      setUniversityFilter(null);
    }
  };

  const handleSortChange = (sortType) => {
    setSortBy(sortType);
    setVisibleCount(8);
    setWelcomeMessage(false);
  };

  const toggleLove = (paperId) => {
    setPaperLoves(prev => {
      const currentLoves = prev[paperId] || 0;
      const isCurrentlyLoved = paperReactions[paperId]?.loved;
      const newLoves = isCurrentlyLoved ? currentLoves - 1 : currentLoves + 1;
      
      return {
        ...prev,
        [paperId]: newLoves
      };
    });
    
    setPaperReactions(prev => ({
      ...prev,
      [paperId]: {
        ...prev[paperId],
        loved: !prev[paperId]?.loved
      }
    }));
  };

  const toggleWishlist = (paperId) => {
    setWishlist(prev => {
      const newWishlist = prev.includes(paperId) 
        ? prev.filter(id => id !== paperId)
        : [...prev, paperId];
      return newWishlist;
    });
  };

  // Scroll carousel in modal
  const scrollCarousel = (direction) => {
    const carousel = carouselRef.current;
    if (carousel) {
      const scrollAmount = direction === 'left' ? -100 : 100;
      carousel.scrollBy({ left: scrollAmount, behavior: 'smooth' });
    }
  };

  const wishlistPapers = useMemo(() => {
    return papers.filter(paper => wishlist.includes(paper.id));
  }, [papers, wishlist]);

  if (loading) {
    return (
      <div className="containerpast">
        <header className="headerpast">
          <h1 className="titlepast">Past Papers</h1>
          <p className="subtitlepast">Access past exam papers for university courses</p>
        </header>
        
        <div className="controlspast">
          <div className="search-containerpast">
            <input
              type="text"
              className="search-inputpast"
              placeholder="Search papers..."
              disabled
            />
          </div>
          <button className="filter-buttonpast" disabled>
            <FiFilter /> Filters
          </button>
        </div>
        
        <div className="gridpast">
          {[...Array(8)].map((_, index) => (
            <div key={index} className="skeleton-cardpast">
              <div className="skeleton-coverpast"></div>
              <div className="skeleton-textpast" style={{ width: '80%' }}></div>
              <div className="skeleton-textpast" style={{ width: '60%' }}></div>
              <div className="skeleton-textpast" style={{ width: '90%' }}></div>
              <div style={{ display: 'flex', justifyContent: 'space-between', marginTop: '10px' }}>
                <div className="skeleton-textpast" style={{ width: '30%' }}></div>
                <div className="skeleton-textpast" style={{ width: '30%' }}></div>
              </div>
            </div>
          ))}
        </div>
      </div>
    );
  }

  return (
    <div className="containerpast">
      {welcomeMessage && (
        <motion.div 
          className="welcome-bannerpast"
          initial={{ opacity: 0, y: -20 }}
          animate={{ opacity: 1, y: 0 }}
          exit={{ opacity: 0 }}
          transition={{ duration: 0.1 }}
        >
          <div className="welcome-contentpast">
            <h3>Welcome to Past Papers Hub!</h3>
            <p>Find exam papers to help with your studies</p>
            <button 
              className="close-welcomepast"
              onClick={() => setWelcomeMessage(false)}
            >
              <FiX size={18} />
            </button>
          </div>
        </motion.div>
      )}

      <header className="headerpast">
        {universityFilter && (
          <button className="back-buttonpast" onClick={() => navigate('/universities')}>
            <FiArrowLeft size={20} /> Back 
          </button>
        )}
        <h1 className="titlepast">
          {universityFilter ? `${universityFilter} Papers` : 'Past Papers'}
        </h1>
      </header>

      <div className="controlspast">
        <div className="search-containerpast">
          <span className="search-iconpast"><FiSearch /></span>
          <input
            type="text"
            className="search-inputpast"
            placeholder="Search papers by course, university, subject or year..."
            value={searchTerm}
            onChange={(e) => setSearchTerm(e.target.value)}
          />
          {searchTerm && (
            <button 
              className="clear-searchpast"
              onClick={() => setSearchTerm('')}
            >
              <FiX size={16} />
            </button>
          )}
        </div>
        
        <div className="filter-wrapperpast">
          <button 
            className={`filter-buttonpast ${showFilters ? 'activepast' : ''}`}
            onClick={toggleFilters}
          >
            <FiFilter /> {activeFilter !== 'all' && '• '}Filters
          </button>
          
          {showFilters && (
            <div className="filter-dropdownpast">
              <div className="filter-sectionpast">
                <h5>Filter by:</h5>
                <div 
                  className={`filter-optionpast ${activeFilter === 'all' ? 'activepast' : ''}`}
                  onClick={() => handleFilterChange('all')}
                >
                  All Papers
                </div>
                {!universityFilter && (
                  <div 
                    className={`filter-optionpast ${activeFilter === 'university' ? 'activepast' : ''}`}
                    onClick={() => handleFilterChange('university')}
                  >
                    By University
                  </div>
                )}
                <div 
                  className={`filter-optionpast ${activeFilter === 'new' ? 'activepast' : ''}`}
                  onClick={() => handleFilterChange('new')}
                >
                  New Uploads
                </div>
                <div 
                  className={`filter-optionpast ${activeFilter === 'recent' ? 'activepast' : ''}`}
                  onClick={() => handleFilterChange('recent')}
                >
                  Recent Years
                </div>
                <div 
                  className={`filter-optionpast ${activeFilter === 'wishlist' ? 'activepast' : ''}`}
                  onClick={() => handleFilterChange('wishlist')}
                >
                  My Wishlist
                </div>
                
                <h5>Sort by:</h5>
                <div 
                  className={`filter-optionpast ${sortBy === 'default' ? 'activepast' : ''}`}
                  onClick={() => handleSortChange('default')}
                >
                  Default
                </div>
                <div 
                  className={`filter-optionpast ${sortBy === 'title' ? 'activepast' : ''}`}
                  onClick={() => handleSortChange('title')}
                >
                  Title (A-Z)
                </div>
                <div 
                  className={`filter-optionpast ${sortBy === 'course' ? 'activepast' : ''}`}
                  onClick={() => handleSortChange('course')}
                >
                  Course (A-Z)
                </div>
                <div 
                  className={`filter-optionpast ${sortBy === 'university' ? 'activepast' : ''}`}
                  onClick={() => handleSortChange('university')}
                >
                  University (A-Z)
                </div>
                <div 
                  className={`filter-optionpast ${sortBy === 'views' ? 'activepast' : ''}`}
                  onClick={() => handleSortChange('views')}
                >
                  Views
                </div>
                <div 
                  className={`filter-optionpast ${sortBy === 'downloads' ? 'activepast' : ''}`}
                  onClick={() => handleSortChange('downloads')}
                >
                  Downloads
                </div>
                <div 
                  className={`filter-optionpast ${sortBy === 'year' ? 'activepast' : ''}`}
                  onClick={() => handleSortChange('year')}
                >
                  Year (Newest)
                </div>
              </div>
            </div>
          )}
        </div>
      </div>

      <motion.button 
        className="wishlist-togglepast"
        onClick={() => setShowWishlist(!showWishlist)}
        whileHover={{ scale: 1.05 }}
        whileTap={{ scale: 0.95 }}
      >
        <FiBookmark />
        <span className="wishlist-countpast">{wishlist.length}</span>
      </motion.button>

      <AnimatePresence>
        {showWishlist && (
          <motion.div
            className="wishlist-panelpast"
            initial={{ x: 300 }}
            animate={{ x: 0 }}
            exit={{ x: 300 }}
            transition={{ type: 'spring', damping: 25 }}
          >
            <div className="wishlist-headerpast">
              <h3 className="wishlist-titlepast">Saved Papers</h3>
              <button className="wishlist-close-buttonpast" onClick={() => setShowWishlist(false)}>
                <FiX size={20} />
              </button>
            </div>

            <div className="wishlist-paperspast">
              {wishlistPapers.length > 0 ? (
                wishlistPapers.map(paper => (
                  <motion.div 
                    key={paper.id}
                    className="wishlist-paper-itempast"
                    onClick={() => {
                      viewPaperDetails(paper);
                      setShowWishlist(false);
                    }}
                    whileHover={{ x: 5 }}
                  >
                    <img className="wishlist-paper-coverpast" src={paper.coverImage} alt={paper.title} />
                    <div className="wishlist-paper-infopast">
                      <h4>{paper.course}</h4>
                      <p>{paper.university} ({paper.year})</p>
                    </div>
                    <button 
                      onClick={(e) => {
                        e.stopPropagation();
                        toggleWishlist(paper.id);
                      }}
                      className="wishlist-remove-buttonpast"
                    >
                      <FiX size={18} />
                    </button>
                  </motion.div> 
                ))
              ) : (
                <div className="wishlist-emptypast">
                  <FiBookmark size={40} color="red" />
                  <p>No Saved Papers</p>
                  <button 
                    className="browse-papers-buttonpast"
                    onClick={() => setShowWishlist(false)}
                  >
                    Browse Papers
                  </button>
                </div>
              )}
            </div>
          </motion.div>
        )}
      </AnimatePresence>

      {displayedPapers.length === 0 ? (
        <div className="empty-statepast">
          <FiFileText size={48} />
          <h3>No papers found</h3>
          <p>Try adjusting your search or filters</p>
          <button 
            className="reset-filterspast"
            onClick={() => {
              setSearchTerm('');
              setActiveFilter('all');
              setSortBy('default');
              setUniversityFilter(null);
            }}
          >
            Reset Filters
          </button>
        </div>
      ) : (
        <>
          <div className="gridpast">
            <AnimatePresence>
              {displayedPapers.map((paper) => (
                <motion.div
                  key={paper.id}
                  className="paper-cardpast"
                  initial={{ opacity: 0, y: 20 }}
                  animate={{ opacity: 1, y: 0 }}
                  exit={{ opacity: 0 }}
                  transition={{ duration: 0.3 }}
                  layout
                  whileHover={{ y: -5 }}
                  onClick={() => viewPaperDetails(paper)}
                >
                  <div className="badge-containerpast">
                    {paper.trending && (
                      <span className="trending-badgepast">
                        <FiTrendingUp size={12} /> Trending
                      </span>
                    )}
                    {paper.newUpload && (
                      <span className="new-badgepast">New</span>
                    )}
                  </div>
                  
                  <img className="paper-coverpast" src={paper.coverImage} alt={paper.title} />
                  
                  <div className="card-contentpast">
                    <h3 className="paper-titlepast">{paper.course}</h3>
                    <p className="paper-descpast">{paper.description}</p>
                  </div>
                  
                  <div className="action-buttonspast">
                    <span className="view-iconpast">
                      <FiEye size={16} /> {paper.views.toLocaleString()}
                    </span>
                    <ReactionButtons
                      itemId={paper.id}
                      loves={paperLoves[paper.id] || 0}
                      onLove={toggleLove}
                      isLoved={paperReactions[paper.id]?.loved}
                    />
                    <button
                      className={`wishlist-buttonpast ${wishlist.includes(paper.id) ? 'activepast' : ''}`}
                      onClick={(e) => {
                        e.stopPropagation();
                        toggleWishlist(paper.id);
                      }}
                    >
                      <FiBookmark 
                        size={16}
                        fill={wishlist.includes(paper.id) ? 'lightgreen' : 'none'} 
                        color={wishlist.includes(paper.id) ? '#6366f1' : '#64748b'}
                      />
                    </button>
                  </div>
                </motion.div>
              ))}
            </AnimatePresence>
          </div>

          {visibleCount < filteredPapers.length && (
            <motion.button 
              className="load-more-buttonpast"
              onClick={loadMore}
              whileHover={{ scale: 1.02 }}
              whileTap={{ scale: 0.98 }}
            >
              Load More ({filteredPapers.length - visibleCount} remaining)
            </motion.button>
          )}
        </>
      )}

      <AnimatePresence>
        {selectedPaper && (
          <motion.div
            className="modal-overlaypast"
            initial={{ opacity: 0 }}
            animate={{ opacity: 1 }}
            exit={{ opacity: 0 }}
            onClick={closeDetails}
          >
            <motion.div
              className="modal-contentpast"
              initial={{ y: 50, opacity: 0 }}
              animate={{ y: 0, opacity: 1 }}
              exit={{ y: 50, opacity: 0 }}
              onClick={(e) => e.stopPropagation()}
            >
              <button className="close-buttonpast" onClick={closeDetails}>
                <FiX size={24} />
              </button>
              
              <div className="modal-headerpast">
                <img 
                  className="paper-coverpast" 
                  src={selectedPaper.coverImage} 
                  alt={selectedPaper.title}
                  style={{ width: '40%', height: '150px', margin: '0 auto 0.1px' }}
                />
                <h2>{selectedPaper.course}</h2>
                <p>{selectedPaper.university} • {selectedPaper.year}</p>
                
                <div className="stats-containerpast">
                  <div className="stat-itempast">
                    <FiDownload /> {selectedPaper.downloads.toLocaleString()} downloads
                  </div>
                </div>
              </div>
              
              <div className="modal-bodypast">
                <div className="carousel-containerpast" ref={carouselRef}>
                  <div className="carousel-itemspast">
                    <span className="carousel-itempast">University: {selectedPaper.university}</span>
                    <span className="carousel-itempast">Course Code: {selectedPaper.courseCode}</span>
                    <span className="carousel-itempast">Subject: {selectedPaper.subject}</span>
                    <span className="carousel-itempast">Year: {selectedPaper.year}</span>
                    <span className="carousel-itempast">Semester: {selectedPaper.semester || 'N/A'}</span>
                    <span className="carousel-itempast">Exam Type: {selectedPaper.examType || 'Final'}</span>
                    <span className="carousel-itempast">Pages: {selectedPaper.pages || 'N/A'}</span>
                  </div>
                  <button
                    className="carousel-arrowpast carousel-arrow-leftpast"
                    onClick={(e) => {
                      e.stopPropagation();
                      scrollCarousel('left');
                    }}
                  >
                    <FiChevronLeft size={16} />
                  </button>
                  <button
                    className="carousel-arrowpast carousel-arrow-rightpast"
                    onClick={(e) => {
                      e.stopPropagation();
                      scrollCarousel('right');
                    }}
                  >
                    <FiChevronRight size={16} />
                  </button>
                </div>
                
                <p className="paper-descpast">
                  {selectedPaper.description || 'No additional description available.'}
                </p>

                <CommentsSection
                  currentMedia={{ id: selectedPaper.id }}
                  currentUser={currentUser}
                  showComments={true}
                  commentsRef={commentsRef}
                  mediaComments={mediaComments}
                  commentLikes={commentLikes}
                  onSubmitComment={handleSubmitComment}
                  onDeleteComment={handleDeleteComment}
                  onLikeComment={handleLikeComment}
                  onReplyToComment={handleReplyToComment}
                />
              
              </div>
              
              <div className="modal-actionspast">
                <Download paper={selectedPaper} variant="full" />
                <ShareButton
                  className="share-buttonpast"
                  whileHover={{ scale: 1.02 }}
                  whileTap={{ scale: 0.98 }}
                  paper={selectedPaper}
                />
                <button
                  className={`modal-wishlist-buttonpast ${wishlist.includes(selectedPaper.id) ? 'activepast' : ''}`}
                  onClick={(e) => {
                    e.stopPropagation();
                    toggleWishlist(selectedPaper.id);
                  }}
                >
                  <FiBookmark 
                    fill={wishlist.includes(selectedPaper.id) ? '#6366f1' : 'none'} 
                    color={wishlist.includes(selectedPaper.id) ? '#6366f1' : '#64748b'}
                  />
                  {wishlist.includes(selectedPaper.id) ? 'Saved' : 'Save'}
                </button>
              </div>
            </motion.div>
          </motion.div>
        )}
      </AnimatePresence>
    </div>
  );
};